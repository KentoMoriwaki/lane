{
  "name": "use-lane",
  "version": "0.1.0",
  "description": "A promise-identity cache for React 19 — useLane/createLane coordinate which promise each key renders, while React owns loading, errors, transitions, and optimistic updates.",
  "license": "MIT",
  "author": "Kento Moriwaki <kentomoriwaki@gmail.com>",
  "homepage": "https://github.com/KentoMoriwaki/lane/tree/main/packages/lane#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KentoMoriwaki/lane.git",
    "directory": "packages/lane"
  },
  "bugs": {
    "url": "https://github.com/KentoMoriwaki/lane/issues"
  },
  "keywords": [
    "react",
    "react-19",
    "data-fetching",
    "cache",
    "suspense",
    "transition",
    "hooks",
    "swr",
    "react-query"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "react": ">=19.2"
  }
}
