{
  "name": "use-lane",
  "version": "0.6.0",
  "description": "Transition-native data fetching for React 19 — Lane caches the promise behind each key and re-reads it inside transitions, while React owns loading, errors, and optimistic UI.",
  "license": "MIT",
  "author": "Kento Moriwaki <kentomoriwaki@gmail.com>",
  "homepage": "https://github.com/KentoMoriwaki/lane/tree/main/packages/lane#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KentoMoriwaki/lane.git",
    "directory": "packages/lane"
  },
  "bugs": {
    "url": "https://github.com/KentoMoriwaki/lane/issues"
  },
  "keywords": [
    "react",
    "react-19",
    "data-fetching",
    "cache",
    "suspense",
    "transition",
    "concurrent",
    "hooks",
    "swr",
    "react-query",
    "agent-skills"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "size": "size-limit",
    "skills:sync": "node ../../scripts/project-docs.mjs skill",
    "prepublishOnly": "pnpm skills:sync && pnpm build",
    "release": "pnpm publish && git push --follow-tags",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "size-limit": "^12.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "react": ">=19.2"
  }
}
